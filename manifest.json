{
  "manifest_version": 3,
  "name": "Unfollow TikTok (MWE)",
  "version": "1.0.0",
  "description": "Test: verificare che il content script si carichi su TikTok.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
